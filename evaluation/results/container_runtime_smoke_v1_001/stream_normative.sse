data: {"type": "message", "content": {"type": "ai", "content": "O dispositivo consultado de Resolu\u00e7\u00e3o 177/2012 possui altera\u00e7\u00e3o parcial registrada por Resolu\u00e7\u00e3o 1056/2026; isso n\u00e3o representa revoga\u00e7\u00e3o total da norma-base.\nPara Resolu\u00e7\u00e3o 177/2012, o conjunto documental utilizado n\u00e3o permite certificar a vig\u00eancia atual.\n\nConte\u00fado controlado.\n\nFontes:\n- Resolu\u00e7\u00e3o 177/2012, art. 68", "normative_result": {"contract_version": "1", "core_version": "structured_output_v2", "status": "ANSWER", "answer": "O dispositivo consultado de Resolu\u00e7\u00e3o 177/2012 possui altera\u00e7\u00e3o parcial registrada por Resolu\u00e7\u00e3o 1056/2026; isso n\u00e3o representa revoga\u00e7\u00e3o total da norma-base.\nPara Resolu\u00e7\u00e3o 177/2012, o conjunto documental utilizado n\u00e3o permite certificar a vig\u00eancia atual.\n\nConte\u00fado controlado.\n\nFontes:\n- Resolu\u00e7\u00e3o 177/2012, art. 68", "references": [{"chunk_id": "ufpi-177-2012-art-68-idx-000067", "norm_id": "ufpi-177-2012", "source": "Resolu\u00e7\u00e3o n\u00ba 177/2012 CEPEX/UFPI \u2014 Regulamento Geral da Gradua\u00e7\u00e3o (consolida\u00e7\u00e3o do corpus)", "article": "68", "validated_subdivision": null, "display_text": "Resolu\u00e7\u00e3o 177/2012, art. 68", "temporal_role": "eligible"}], "temporal_provenance": {"temporal_intent": "indeterminate", "requested_time_context": {"norm_ids": ["ufpi-177-2012"], "before_amendment": false, "relation_query": null, "article": "68", "paragraph": null, "requested_year": null}, "evidence_states": [{"chunk_id": "ufpi-177-2012-art-68-idx-000067", "source_norm": "ufpi-177-2012", "source_article": "68", "temporal_action": "amendment_applied", "normative_status": "desconhecida", "temporal_role": "eligible", "relation_source": {"source": "Resolu\u00e7\u00e3o CEPEX/UFPI n\u00ba 1.056/2026", "article": "1"}}], "known_relations": [{"relation": "AMENDED_BY", "source_norm": "ufpi-177-201