            "chunk_id": "ufpi-177-2012-art-18-idx-000017",
            "norm_id": "ufpi-177-2012",
            "source": "Resolução nº 177/2012 CEPEX/UFPI — Regulamento Geral da Graduação (consolidação do corpus)",
