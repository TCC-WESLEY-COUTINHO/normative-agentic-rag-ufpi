# Chatbot UFPI: obrigatorias para o agente padrao (chatbot_ufpi_v2)
# Nunca coloque valores reais neste arquivo versionado. Copie-o para .env.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Baseline operacional provisoria da Resolucao 177/2012
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=normative-agentic-rag-ufpi
OPENROUTER_HTTP_REFERER=
OPENROUTER_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800

RETRIEVAL_TOP_K=5
CHROMA_COLLECTION=ufpi_graduacao_177_2012
CHROMA_PERSIST_DIR=.local/chroma
CORPUS_PATH=scripts/chunks_v2.json

# Persistencia da API
# O Compose de producao usa postgres por padrao; fora dele, o codigo usa sqlite.
DATABASE_TYPE=postgres

# Obrigatorias quando DATABASE_TYPE=postgres
# O codigo monta uma URI sem URL-encoding; use valores seguros para URI em
# POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB (letras, numeros, _ e -).
POSTGRES_USER=rag_chatbot
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot

# Opcionais para PostgreSQL
POSTGRES_APPLICATION_NAME=rag-chatbot-ufpi
POSTGRES_MIN_CONNECTIONS_PER_POOL=1
POSTGRES_MAX_CONNECTIONS_PER_POOL=3

# Usada somente quando DATABASE_TYPE=sqlite
SQLITE_DB_PATH=checkpoints.db

# API e frontend
HOST=0.0.0.0
PORT=8080
# Se definida, a mesma chave deve estar disponivel para API e frontend.
AUTH_SECRET=
# No Compose, este valor e sobrescrito pela URL interna do servico.
AGENT_URL=http://localhost:8080
MODE=

# Modelo padrao. Se vazio, o primeiro provedor habilitado define o padrao;
# com OPENAI_API_KEY, o padrao do codigo e gpt-4o-mini.
DEFAULT_MODEL=gpt-4o-mini

# Opcionais usados apenas pelo Compose de producao
API_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1

# Observabilidade opcional efetivamente lida pela aplicacao
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=default
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Provedores de LLM alternativos herdados do template e ainda suportados
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_MAP=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GROQ_API_KEY=
USE_AWS_BEDROCK=false
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# Endpoint compativel com a API OpenAI (os tres campos formam uma configuracao)
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Utilitarios/agentes herdados, atualmente fora do fluxo UFPI padrao
OPENWEATHERMAP_API_KEY=
AWS_KB_ID=
USE_FAKE_MODEL=false

# MongoDB: alternativa de checkpointer suportada pelo codigo, mas nao pelo Compose.
# MONGO_HOST, MONGO_PORT e MONGO_DB sao obrigatorias quando DATABASE_TYPE=mongo.
# Se uma credencial for usada, MONGO_USER, MONGO_PASSWORD e MONGO_AUTH_SOURCE
# devem ser fornecidas em conjunto. O store de longo prazo continua em memoria.
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=

# Nomes mantidos do template original. A classe Settings deste projeto nao os le;
# prefira LANGCHAIN_* acima. Bibliotecas externas podem interpreta-los diretamente.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
