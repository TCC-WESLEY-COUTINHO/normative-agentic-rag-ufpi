# Copie para .env (nunca versione o .env). Valores vazios são ignorados pelo código.
# Só o backend lê este arquivo; nada dele vai para as imagens.
# Detalhes: docs/INSTALACAO.md e docs/DEPLOY_LINUX.md.

# -----------------------------------------------------------------------------
# 1. Pipeline normativo (agente do protótipo, chatbot_ufpi_integrated_v1)
# -----------------------------------------------------------------------------
# O pipeline fala com QUALQUER endpoint compatível com a API da OpenAI
# (/chat/completions com response_format json_schema e /embeddings).
# Os nomes OPENROUTER_* são históricos: valem para OpenRouter, OpenAI, outros
# provedores compatíveis e servidores locais (Ollama, vLLM com proxy).
#
# Condição implantada: v3.4, com geração ancorada em citação e corpus canônico v4.
# A arquitetura conversacional continua A''-J v2 (Jev + política v2).
# No compose.demo, qualquer valor diferente faz o launcher recusar o início
# (a configuração deixa de ser a avaliada); para outros provedores, use a seção 2.
#
# O intérprete Jev usa OPENROUTER_API_KEY na Decisions API da OpenRouter, em
# endereço fixo. Trocar EMBEDDING_MODEL exige um índice gerado com o mesmo modelo.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Geração (GENERATION_MODE=cited_v3 e CORPUS_PROFILE=duas-regulacoes-v4 são fixados
# pelo compose.demo; ver seção 6)
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Scope Gate e Router; vazio = LLM_MODEL
ROUTER_MODEL=
# Deve ser o modelo usado para gerar o índice
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_APP_NAME=normative-agentic-rag-ufpi
OPENROUTER_HTTP_REFERER=
# Respostas fixas a perguntas sobre o próprio assistente ("quem é você?", "qual é o
# seu nome?"), dadas antes do Scope Gate, sem chamada a modelo nem recuperação.
# off reproduz o grafo conversacional congelado da v3.4; as avaliações usam off.
ASSISTANT_IDENTITY=on

# -----------------------------------------------------------------------------
# 2. Provedor compatível com a OpenAI, local ou remoto
#    (deploy/compose.openai-compatible.yaml; NÃO é a configuração avaliada)
# -----------------------------------------------------------------------------
# Só são lidas quando o override acima é usado. COMPAT_LLM_MODEL e
# COMPAT_EMBEDDING_MODEL são obrigatórias nesse modo.
#
# Exemplos de preenchimento:
#   Ollama no host: mantenha a URL e a chave padrão; modelos qwen2.5:7b-instruct
#     (chat) e nomic-embed-text (embeddings).
#   OpenAI direta: URL https://api.openai.com/v1, chave da OpenAI, modelos
#     gpt-4o-mini (chat) e text-embedding-3-small (embeddings).
COMPAT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Chave do provedor; "local" para Ollama
COMPAT_LLM_API_KEY=local
COMPAT_LLM_MODEL=
COMPAT_ROUTER_MODEL=
COMPAT_EMBEDDING_MODEL=
# Um índice por modelo de embeddings
COMPAT_INDEX_DIR=./.local/index-compat
# none (camada de A') ou structured_llm
COMPAT_CONVERSATION_INTERPRETER=none
# Ex.: {"llm_model":"qwen2.5:7b-instruct"} com structured_llm
COMPAT_CONVERSATION_INTERPRETER_CONFIG={}

# -----------------------------------------------------------------------------
# 3. Outros agentes do serviço (template e serviço anterior)
# -----------------------------------------------------------------------------
# Lidos por core/settings.py para o chatbot_generic e os agentes históricos do
# registro em agents/agents.py. Não alteram o pipeline normativo. chatbot_ufpi e
# chatbot_ufpi_v2 e o Vertex AI (arquivo de credenciais montado) não são
# suportados nesta versão.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_MAP={}
USE_AWS_BEDROCK=false
OLLAMA_MODEL=
OLLAMA_BASE_URL=
# Endpoint genérico compatível com a OpenAI para os agentes do template
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
# Vazio = primeiro provedor habilitado
DEFAULT_MODEL=
USE_FAKE_MODEL=false

# -----------------------------------------------------------------------------
# 4. Serviço e observabilidade
# -----------------------------------------------------------------------------
# Se definida, a API exige "Authorization: Bearer <AUTH_SECRET>" e o compose.demo
# a repassa também à interface, que envia o cabeçalho. Defina-a em servidores.
AUTH_SECRET=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=default
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# 5. PostgreSQL (checkpoints das conversas)
# -----------------------------------------------------------------------------
# Obrigatória: senha do PostgreSQL. No compose.demo, o container postgres é
# criado com ela na primeira subida (trocá-la depois exige alterar o usuário no
# banco ou apagar o volume postgres_data).
POSTGRES_PASSWORD=
# Opcionais. Vazias = container postgres do compose.demo, banco e usuário tcc2.
# Para um PostgreSQL externo (deploy/compose.external-postgres.yaml), defina
# POSTGRES_HOST com o endereço dele.
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=

# -----------------------------------------------------------------------------
# 6. Docker Compose (lidas pelo compose, não pelo código)
# -----------------------------------------------------------------------------
# Índice com a coleção ufpi_duas_regulacoes_setor_v4.
# Em code/, com CHROMA_PERSIST_DIR apontando para INDEX_DIR:
# uv run --frozen python -m rag_baseline.index --profile duas-regulacoes-v4 --rebuild
INDEX_DIR=./.local/index
INTERFACE_PORT=8501
# Usadas com deploy/compose.api.yaml
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
PROTOTYPE_IMAGE_TAG=v3.4-local
#
# Fixadas pelo compose.demo.yaml (o .env não as altera): intérprete Jev com a
# política de transição v2, geração cited_v3, perfil duas-regulacoes-v4,
# 5 trechos recuperados, roteador intent_v1,
# checkpoints em PostgreSQL, diretório do índice, host e porta do backend.
